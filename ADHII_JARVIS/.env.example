# =================================================================
# ADHII JARVIS — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Instructions:
# 1. Copy this file to .env in the backend/ and frontend/ directories.
# 2. Fill in your API keys and service URLs.
# 3. DO NOT commit your actual .env files to GitHub.
# =================================================================

# -----------------------------------------------------------------
# 1. BACKEND CORE CONFIGURATION
# -----------------------------------------------------------------
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------
# 2. AI & LLM PROVIDERS
# -----------------------------------------------------------------
# Recommended: Groq (100% Free, ultra-fast 500 tokens/sec Llama 3.3 70B)
# Get free key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI (GPT-4o)
OPENAI_API_KEY=

# Optional: Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------
# 3. VOICE & AUDIO (British J.A.R.V.I.S.)
# -----------------------------------------------------------------
# TTS: 'edge-tts' provides free British Ryan/Thomas neural voice (No API key needed!)
TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=

# STT: 'whisper' or browser Web Speech API
STT_PROVIDER=whisper
STT_API_KEY=

# -----------------------------------------------------------------
# 4. EXTERNAL TOOLS & SEARCH (Optional)
# -----------------------------------------------------------------
WEATHER_API_KEY=
SEARCH_API_KEY=

# -----------------------------------------------------------------
# 5. SUPABASE DATABASE & AUTH (100% Free at https://supabase.com)
# -----------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------
# 6. FRONTEND (Vite Client Variables)
# -----------------------------------------------------------------
# Local: http://localhost:8000
# Cloud (Render): https://your-backend-app.onrender.com
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
